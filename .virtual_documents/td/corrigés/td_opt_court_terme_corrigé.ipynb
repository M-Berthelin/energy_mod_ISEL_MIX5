def marche_deux_zones(s_nom=None):
    # Réseau vide : conteneur de tous les composants (bus, générateurs, charges, liens...)
    m = pypsa.Network()
    # Bus = nœud du réseau : tous les composants s'y raccordent et y respectent l'équilibre offre-demande
    m.add("Bus", "nord")
    m.add("Bus", "sud")
    # Generator = centrale ou source (p_nom : puissance installée en MW, marginal_cost : coût variable en EUR/MWh)
    m.add("Generator", name=[f"vente_{i}" for i in range(len(offres_vente["quantite"]))], bus=offres_vente["zone"],
          marginal_cost=offres_vente["prix"], p_nom=offres_vente["quantite"])
    m.add("Generator", name=[f"achat_{i}" for i in range(len(offres_achat["quantite"]))], bus=offres_achat["zone"],
          p_nom=offres_achat["quantite"], marginal_cost=[-p for p in offres_achat["prix"]], sign=-1)
    if s_nom is not None:
        # Line = ligne alternative soumise aux lois de Kirchhoff (s_nom : capacité, x : réactance)
        m.add("Line", "interconnexion", bus0="nord", bus1="sud", s_nom=s_nom)
    # optimize : construit le problème linopy, le résout avec le solveur et écrit les résultats dans le réseau
    m.optimize(solver_name="highs")
    return m

