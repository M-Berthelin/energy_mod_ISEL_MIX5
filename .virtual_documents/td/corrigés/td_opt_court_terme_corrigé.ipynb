def copier_reseau(n):
    """Copie un réseau, y compris s'il a déjà été optimisé.

    Dans les versions récentes de PyPSA, `n.copy()` refuse de copier un réseau résolu
    tant que le modèle du solveur est attaché : on le détache d'abord.
    """
    if getattr(n, "model", None) is not None:
        n.model.solver_model = None
    return n.copy()



