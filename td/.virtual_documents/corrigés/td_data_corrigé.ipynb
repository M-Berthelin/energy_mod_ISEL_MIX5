# Sensibilité au tampon (buffer) et aux classes CORINE.
# On recrée le conteneur d'exclusion à chaque scénario pour ne pas cumuler les exclusions.
from atlite.gis import ExclusionContainer, shape_availability

url_natura = "https://tubcloud.tu-berlin.de/s/mxgaA7wH8NsmdDi/download/Natura2000_end2021-PT.gpkg"
url_corine = "https://tubcloud.tu-berlin.de/s/Mw5dwbwdsDY8zfH/download/U2018_CLC2018_V2020_20u1-PT.tif"

sensitivity = []
for buffer_m in [0, 800, 2000]:
    ex = ExclusionContainer(crs=3035, res=100)
    ex.add_geometry(url_natura)
    ex.add_raster(url_corine, codes=[1, 2, 3, 4, 5, 6], crs=3035, buffer=buffer_m, nodata=48)
    ex.add_raster(url_corine, codes=[12, 13, 18, 19, 20, 21], crs=3035, invert=True, nodata=48)
    avail, transform = shape_availability(shape, ex)
    eligible_area_km2 = float(avail.sum()) * (ex.res ** 2) / 1e6
    sensitivity.append({"buffer_m": buffer_m, "eligible_area_km2": eligible_area_km2})
pd.DataFrame(sensitivity)
### FIN SOLUTION





