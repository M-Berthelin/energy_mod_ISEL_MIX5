# Question 1 : production d'énergie totale de panneaux orientés plein sud, pour des inclinaisons de 0° à 90°.
tilts = list(range(0, 91, 10))
energy_by_tilt = {}
for tilt in tilts:
    pv_tilt = cutout.pv(
        panel="CSi",
        orientation={"slope": float(tilt), "azimuth": 180.0},
        matrix=capacity_matrix,
        index=shape.index,
    )
    energy_by_tilt[tilt] = float(pv_tilt.sum())
pd.Series(energy_by_tilt, name="Production d'énergie en janvier").plot(marker="o", xlabel="Inclinaison (degrés)", ylabel="Production cumulée")

# Question 2 : profil de production du 1er janvier pour chaque azimut.
azimuths = [0, 90, 180, 270]
profiles = {}
for azimuth in azimuths:
    pv_azimuth = cutout.pv(
        panel="CSi",
        orientation={"slope": 30.0, "azimuth": float(azimuth)},
        matrix=capacity_matrix,
        index=shape.index,
    )
    profiles[azimuth] = pv_azimuth.sel(time="2013-01-01").sum(dim="name") if "name" in pv_azimuth.dims else pv_azimuth.sel(time="2013-01-01")
for azimuth, profile in profiles.items():
    profile.plot(label=f"Azimut {azimuth}°")
plt.legend()

# Question 3 : comparaison des modes de suivi du soleil pour le 31 janvier.
tracking_modes = [None, "horizontal", "vertical", "dual"]
tracking_energy = {}
for tracking in tracking_modes:
    pv_tracking = cutout.pv(
        panel="CSi",
        orientation={"slope": 30.0, "azimuth": 180.0},
        tracking=tracking,
        matrix=capacity_matrix,
        index=shape.index,
    )
    tracking_energy[str(tracking)] = pv_tracking.sel(time="2013-01-31").sum()
tracking_energy
