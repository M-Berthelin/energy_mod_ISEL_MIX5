# Étape 2 : suppression de la ligne : remove(type de composant, nom)
n_t1.remove("Line", "SA-MZ")

# Étape 3 : optimisation ; on récupère le statut pour vérifier que le problème reste faisable
statut, condition = n_t1.optimize(solver_name="highs", log_to_console=False)
print("Statut :", statut, "| condition :", condition)

# Étape 4 : dispatch et prix sans interconnexion
print("Dispatch sans interconnexion :")
display(n_t1.generators_t.p)
print("Prix marginaux sans interconnexion :")
display(n_t1.buses_t.marginal_price)

# Étape 5 : comparaison des coûts
print(f"Coût sans ligne : {n_t1.objective:,.0f} EUR/h | référence : {n.objective:,.0f} EUR/h")
print(f"Surcoût : {n_t1.objective - n.objective:,.0f} EUR/h ({100 * (n_t1.objective / n.objective - 1):.1f} %)")
### FIN SOLUTION











