# Coûts des combustibles en EUR par MWh thermique (un dictionnaire : clé = combustible)
fuel_cost = dict(
    coal=8,
    gas=100,
    oil=48,
)





# Rendement des centrales : MWh électriques produits par MWh thermique consommé
efficiency = dict(
    coal=0.33,
    gas=0.58,
    oil=0.35,
)





# Émissions spécifiques en tonnes de CO2 par MWh thermique
emissions = dict(
    coal=0.34,
    gas=0.2,
    oil=0.26,
    hydro=0,
    wind=0,
)





# Capacités installées (MW) : un dictionnaire par pays, contenant un dictionnaire par technologie
power_plants = {
    "SA": {"coal": 35000, "wind": 3000, "gas": 8000, "oil": 2000},
    "MZ": {"hydro": 1200},
}





# Demande électrique (MW) de chaque pays
loads = {
    "SA": 42000,
    "MZ": 650,
}








# Convention : PyPSA est importé sans alias
import pypsa


# Option : inclure la constante de l'objectif (évite un avertissement et rend l'objectif comparable à linopy)
pypsa.options.params.optimize.include_objective_constant = True





# Le réseau : conteneur vide de tous les composants
n = pypsa.Network()





# n.add(type de composant, nom, attributs...) ; x, y = longitude et latitude ; v_nom = tension nominale (kV)
n.add("Bus", "SA", y=-30.5, x=25, v_nom=400)
n.add("Bus", "MZ", y=-18.5, x=35.5, v_nom=400)





# Tableau (DataFrame) des bus du réseau
n.buses








# Plusieurs vecteurs ajoutés d'un coup : une liste de noms, puis des paramètres.
# co2_emissions doit être une pandas.Series (clés = noms des vecteurs) ; les listes sont aussi possibles
n.add(
    "Carrier",
    ["coal", "gas", "oil", "hydro", "wind"],
    co2_emissions=pd.Series(emissions),
    nice_name=["Coal", "Gas", "Oil", "Hydro", "Onshore Wind"],
    color=["dimgrey", "tomato", "olive", "seagreen", "royalblue"],
)

# Un vecteur « AC » pour les charges électriques
n.add("Carrier", "AC", nice_name="Electricity", color="crimson")








# Un générateur : nom, bus de raccordement, vecteur, puissance nominale (MW) et coût marginal (EUR/MWh)
n.add(
    "Generator",
    "MZ hydro",
    bus="MZ",
    carrier="hydro",
    p_nom=1200,  # MW
    marginal_cost=0,  # valeur par défaut
)





# Une boucle sur les technologies sud-africaines.
# Le coût marginal d'une centrale thermique = coût du combustible / rendement
# (.get(tech, 1) renvoie 1 pour les technologies sans rendement, ex. le vent ; .get(tech, 0) renvoie 0 pour un coût de combustible nul)
for tech, p_nom in power_plants["SA"].items():
    n.add(
        "Generator",
        f"SA {tech}",
        bus="SA",
        carrier=tech,
        efficiency=efficiency.get(tech, 1),
        p_nom=p_nom,
        marginal_cost=fuel_cost.get(tech, 0) / efficiency.get(tech, 1),
    )





# Tableau des générateurs : une ligne par générateur, une colonne par attribut
n.generators





# Une charge : p_set est la puissance consommée (MW)
n.add(
    "Load",
    "SA electricity demand",
    bus="SA",
    p_set=loads["SA"],
    carrier="AC",
)


n.add(
    "Load",
    "MZ electricity demand",
    bus="MZ",
    p_set=loads["MZ"],
    carrier="AC",
)


# Tableau des charges
n.loads





# Une ligne entre deux bus : bus0 -> bus1, capacité s_nom (MW), réactance x et résistance r
n.add(
    "Line",
    "SA-MZ",
    bus0="SA",
    bus1="MZ",
    s_nom=500,
    x=1,
    r=1,
)


# Tableau des lignes
n.lines





# Carte statique du réseau
n.plot(bus_size=1, margin=1);





# Carte interactive du réseau
n.explore(bus_size=2e3, line_width=10)








# Construit le problème, le résout avec HiGHS et écrit les résultats dans le réseau
n.optimize(solver_name="highs", log_to_console=False)





# Production de chaque générateur à chaque pas de temps (MW) : tableau pas de temps x générateurs
n.generators_t.p





# Production rapportée à la capacité nominale : le facteur de charge de chaque générateur
n.generators_t.p / n.generators.p_nom





# Flux de puissance de bus0 vers bus1 (négatif : l'énergie circule de bus1 vers bus0)
n.lines_t.p0


# Flux mesuré côté bus1 (même valeur au signe près, aux pertes près)
n.lines_t.p1








# Prix marginal de chaque bus : valeur duale de l'équilibre offre-demande (EUR/MWh)
n.buses_t.marginal_price





# Le modèle linopy construit par PyPSA : variables et contraintes
n.model


# Contrainte : production <= capacité nominale x disponibilité (p_max_pu)
n.model.constraints["Generator-fix-p-upper"]


# Contrainte d'équilibre nodal (KCL) : une par bus et par pas de temps
n.model.constraints["Bus-nodal_balance"]


# Fonction objectif : coût d'exploitation total
n.model.objective


# Valeurs duales de la limite de production : rente de chaque générateur (EUR par MW)
n.model.constraints["Generator-fix-p-upper"].dual.to_dataframe()








# Charge totale de chaque bus (somme des charges qui lui sont rattachées)
s = n.loads.groupby("bus").p_set.sum()
s


# Cercles dimensionnés selon la charge, couleurs et épaisseurs réglables
n.explore(
    bus_size=s,
    bus_color="orange",
    bus_alpha=1,
    line_color="orchid",
    line_width=30,
)





# Production de chaque générateur à l'instant « now » (une Series)
n.generators_t.p.loc["now"]





# On regroupe la production par (bus, vecteur) : un cercle par bus, divisé par vecteur
s = n.generators_t.p.loc["now"].groupby([n.generators.bus, n.generators.carrier]).sum()
s





# line_flow : flux sur les lignes (divisé par 5 pour une échelle lisible)
n.explore(
    bus_size=s,
    line_width=30,
    line_flow=n.lines_t.p0.loc["now"] / 5,
)











# Modifier un paramètre = écrire dans le tableau : .loc[nom du composant, nom de l'attribut]
n.lines.loc["SA-MZ", "s_nom"] = 400
n.lines


# On relance l'optimisation avec la nouvelle capacité de ligne
n.optimize(log_to_console=False)





n.generators_t.p














# Émissions de chaque générateur (t de CO2) = production / rendement x émissions spécifiques du vecteur
e = (
    n.generators_t.p
    / n.generators.efficiency
    * n.generators.carrier.map(n.carriers.co2_emissions)
)
e





# Émissions totales (somme sur les générateurs et les pas de temps)
e.sum().sum()





# Une contrainte globale : somme des émissions de tous les composants <= constante
# carrier_attribute="co2_emissions" : PyPSA utilise l'attribut co2_emissions des vecteurs
n.add(
    "GlobalConstraint",
    "emission_limit",
    carrier_attribute="co2_emissions",
    sense="<=",
    constant=e.sum().sum() * 0.9,  # 90 % des émissions initiales
)


n.optimize(log_to_console=False)


# Nouveau dispatch : moins de charbon et de pétrole, plus de gaz
n.generators_t.p


n.generators_t.p / n.generators.p_nom


# mu : valeur duale de la contrainte d'émissions = prix implicite du CO2 (négatif pour une contrainte <=)
n.global_constraints.mu





# On vise 85 % des émissions initiales (et non 0,85 tonne !)
n.global_constraints.loc["emission_limit", "constant"] = e.sum().sum() * 0.85


n.optimize(log_to_console=False)





# On revient à la contrainte à 90 % des émissions initiales
n.global_constraints.loc["emission_limit", "constant"] = e.sum().sum() * 0.9








# Enregistrer le réseau dans un fichier netCDF
n.export_to_netcdf("tmp.nc");


# Relire un réseau depuis un fichier
n_nc = pypsa.Network("tmp.nc")





